# ---- Chain ----
# Base Sepolia testnet (chain id 84532). Get test ETH from a faucet, see README.
CHAIN=base-sepolia
RPC_URL=https://sepolia.base.org

# Agent hot key. TESTNET ONLY. Generate with `npm run keygen` (writes it here for you).
AGENT_PRIVATE_KEY=

# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Safety ----
POLICY_FILE=config/policy.json
SCHEDULES_FILE=config/schedules.json
AUDIT_LOG=data/audit.jsonl
# Mainnet is refused unless this is exactly "true".
ALLOW_MAINNET=false
