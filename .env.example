# ---- Chain ----
# Base Sepolia testnet (chain id 84532). Get test ETH from a faucet, see README.
CHAIN=base-sepolia
RPC_URL=https://sepolia.base.org
# Optional comma-separated fallbacks, tried in order when RPC_URL fails.
# RPC_FALLBACK_URLS=https://base-sepolia-rpc.publicnode.com

# Agent hot key. TESTNET ONLY. Generate with `npm run keygen` (writes it here for you).
AGENT_PRIVATE_KEY=

# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- AgentVault (optional, for the evidence doc) ----
# VAULT_ADDRESS=
# VAULT_DEPLOY_TX=
# VAULT_SET_RECIPIENT_TX=
# VAULT_SEND_TX=
# VAULT_REVERT_TX=
# VAULT_DENY_TX=
# Route native transfers through the vault's agentSend (on-chain caps).
# VAULT=true
# Second vault (AgentVaultV2: session keys + ERC-20). Shown as its own section.
# VAULT2_ADDRESS=
# VAULT2_DEPLOY_TX=
# VAULT2_GRANT_SESSION_TX=
# VAULT2_SEND_TX=
# VAULT2_REVERT_TX=
# With a v2 vault (VAULT_ADDRESS pointing at it), also route ERC-20 transfers
# through agentSendToken, so the vault's token cap applies on-chain too.
# VAULT_TOKENS=true

# ---- x402 paid API demo (optional) ----
# Start the demo server with `npm run x402:api`, then uncomment these.
# X402_API_URL=http://127.0.0.1:8790
# Address that receives the payments (put it in the policy allowlist).
# X402_PAY_TO=0x4785Dca37A242F3D80f844CB0b143A687008a2B5
# X402_PRICE=0.0002
# X402_PORT=8790

# ---- Web UI ----
# Interface the UI binds to. Leave loopback unless you run it in the Docker
# image (compose sets 0.0.0.0 inside the container and publishes loopback only).
# WEB_HOST=127.0.0.1

# ---- Background schedules (optional) ----
# Run the enabled rules in config/schedules.json while `serve` is up. Each rule
# still goes through the policy engine; a T2 rule waits for an owner in the UI.
# SCHEDULER=true
# SCHEDULER_INTERVAL_SEC=60

# ---- Telegram approvals (optional) ----
# T2 requests are also posted to this chat with Approve / Reject buttons.
# Create a bot with @BotFather; the chat id is a number. The token is a secret.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- Safety ----
POLICY_FILE=config/policy.json
# Pin the policy file (S4): print the value with `npm run cli -- policy hash`.
# Start-up refuses a policy file that does not match.
# POLICY_SHA256=
SCHEDULES_FILE=config/schedules.json
AUDIT_LOG=data/audit.jsonl
# Mainnet is refused unless this is exactly "true".
ALLOW_MAINNET=false
